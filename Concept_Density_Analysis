def get_umls_concepts(text, api_key=UMLS_API_KEY, timeout=10, use_cache=True):

    global _umls_cache
    
    if not text or pd.isna(text):
        return []
    
    text_key = str(text)[:200]  # Use truncated text as cache key
    
    # Check cache first
    if use_cache and text_key in _umls_cache:
        return _umls_cache[text_key]
    
    try:
        # Extract all words/phrases - break into chunks for better matching
        phrases = set()
        words = str(text).lower().split()
        
        # Add individual words and multi-word phrases
        for i, word in enumerate(words):
            if len(word) > 3:  # Skip very short words
                phrases.add(word.strip('.,!?;:'))
            if i < len(words) - 1:
                phrase = f"{words[i]} {words[i+1]}"
                if len(phrase) > 5:
                    phrases.add(phrase)
        
        concepts = []
        
        # Query each phrase against UMLS
        for phrase in list(phrases)[:MAX_PHRASES_PER_IMPRESSION]:
            if not phrase or len(phrase) < 2:
                continue
            
            try:
                # Use UMLS search endpoint with best match strategy
                params = {
                    'string': phrase,
                    'searchType': 'rightTrunc',  # Prefix matching for flexibility
                    'apikey': api_key,
                    'pageSize': 5  # Get top 5 results
                }
                
                response = requests.get(
                    f'{UMLS_BASE_URL}/search/current',
                    params=params,
                    timeout=timeout
                )
                
                if response.status_code == 200:
                    data = response.json()
                    if 'result' in data and 'results' in data['result']:
                        for result in data['result']['results'][:3]:  # Take top 3 matches
                            concept = {
                                'cui': result.get('ui'),
                                'term': result.get('name'),
                                'sem_types': result.get('semanticTypes', []),
                                'score': result.get('score', 0)
                            }
                            # Avoid duplicates
                            if concept not in concepts:
                                concepts.append(concept)
                
                time.sleep(API_SLEEP_SECONDS)
                
            except requests.exceptions.Timeout:
                pass  # Skip this phrase on timeout
            except Exception as e:
                pass  # Skip problematic phrases
        
        # Cache the result
        _umls_cache[text_key] = concepts
        
        return concepts
        
    except Exception as e:
        print(f"  Warning: Error querying UMLS API: {e}")
        return []


