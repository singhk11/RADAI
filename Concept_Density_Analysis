        '--refresh-correlations-only',
        action='store_true',
        help='Reuse cached concept density from concept_density_sample_analysis.csv and only recompute edit distances/correlations.'
    )
    parser.add_argument(
        '--force-recompute-concepts',
        action='store_true',
        help='Force full concept extraction even if cached concept density sample exists.'
    )
    args = parser.parse_args()

    print("\n" + "="*80)
    print("UMLS CONCEPT DENSITY ANALYSIS")
    print("="*80)
    
    # Load or initialize UMLS cache
    print("\n[0/8] Initializing UMLS cache...")
    load_umls_cache()
    
    # Load data
    print("\n[1/8] Loading impression data...")
    df = pd.read_csv(DATA_PATH)
    df_radai = df[(df['n_inferences'].notna()) & (df['n_inferences'] >= 1)].copy()
    df_both = df_radai[df_radai['omni_impression'].notna()].copy()
    df_both['omni_impression_clean'] = df_both['omni_impression'].astype(str).str.strip()
    df_both['impression_clean'] = df_both['impression'].apply(clean_impression_field)
    df_both = df_both[df_both['omni_impression_clean'] != ''].copy()
    
    print(f"  Total RADAI impressions: {len(df_radai):,}")
    print(f"  With populated omni_impression: {len(df_both):,}")
    print(f"  Using sample for UMLS analysis: {min(SAMPLE_SIZE, len(df_both)):,}")
    
    # Sample for API efficiency
    if len(df_both) > SAMPLE_SIZE:
        df_analyze = df_both.sample(n=SAMPLE_SIZE, random_state=RANDOM_STATE).copy()
    else:
        df_analyze = df_both.copy()
    
    concept_cache_available = os.path.exists(CONCEPT_SAMPLE_CACHE_PATH)
    reuse_cached_concepts = (args.refresh_correlations_only or concept_cache_available) and not args.force_recompute_concepts

    if reuse_cached_concepts:
        print(f"\n[2/8] Reusing cached concept density data...")
        if concept_cache_available:
            print(f"  Loading: {CONCEPT_SAMPLE_CACHE_PATH}")
            df_cached = pd.read_csv(CONCEPT_SAMPLE_CACHE_PATH)
            needed_cols = ['impression', 'n_concepts', 'word_count', 'concept_density']
            missing_cols = [c for c in needed_cols if c not in df_cached.columns]
            if missing_cols:
                print(f"  Cached file missing columns {missing_cols}; falling back to full extraction")
                reuse_cached_concepts = False
            else:
                concept_lookup = (
                    df_cached[needed_cols]
                    .dropna(subset=['impression'])
                    .drop_duplicates(subset=['impression'])
                    .rename(columns={'impression': 'impression_clean'})
                )
                df_analyze = df_analyze.merge(concept_lookup, on='impression_clean', how='left')
                missing_concept_rows = df_analyze['concept_density'].isna().sum()
                print(f"  Reused concept density for {len(df_analyze) - missing_concept_rows:,} / {len(df_analyze):,} rows")
                
                # If --refresh-correlations-only, filter to only cached rows and skip UMLS extraction
                if args.refresh_correlations_only:
                    if missing_concept_rows > 0:
                        print(f"  Filtering to cached rows only (--refresh-correlations-only flag set)")
                        print(f"  Removing {missing_concept_rows:,} rows without cached concept density")
                        df_analyze = df_analyze[df_analyze['concept_density'].notna()].copy()
                        print(f"  Continuing with {len(df_analyze):,} rows with cached concepts")
                    df_analyze['concepts'] = np.nan
                elif missing_concept_rows > 0:
                    # Only extract missing concepts if NOT explicitly doing --refresh-correlations-only
                    print(f"  Missing cached concept density in {missing_concept_rows:,} rows; extracting only missing impressions")
                    unique_missing = list(df_analyze[df_analyze['concept_density'].isna()]['impression_clean'].astype(str).unique())
                    concept_map = build_or_update_concept_map(unique_missing)
                    df_missing = df_analyze['concept_density'].isna()
                    df_analyze.loc[df_missing, 'concepts'] = df_analyze.loc[df_missing, 'impression_clean'].astype(str).map(concept_map)
                    df_analyze.loc[df_missing, 'n_concepts'] = df_analyze.loc[df_missing, 'concepts'].apply(len)
                    df_analyze.loc[df_missing, 'word_count'] = df_analyze.loc[df_missing, 'impression_clean'].astype(str).str.split().str.len()
                    df_analyze.loc[df_missing, 'concept_density'] = df_analyze.loc[df_missing].apply(
                        lambda row: calculate_concept_density(row['impression_clean'], row['concepts']),
                        axis=1
                    )
                else:
                    df_analyze['concepts'] = np.nan

    if not reuse_cached_concepts:
        # Extract concepts from impressions using UMLS API with fallback
        print(f"\n[2/8] Extracting medical concepts (using UMLS API + heuristic fallback)...")
        print(f"  Processing {len(df_analyze):,} impressions...")
        print(f"  Note: UMLS API queries are cached and rate-limited ({API_SLEEP_SECONDS:.2f}s per request)")

        unique_impressions = list(df_analyze['impression_clean'].astype(str).unique())
        print(f"  Unique impressions to query: {len(unique_impressions):,} (from {len(df_analyze):,} rows)")

        concept_map = build_or_update_concept_map(unique_impressions)

        df_analyze['concepts'] = df_analyze['impression_clean'].astype(str).map(concept_map)
        df_analyze['n_concepts'] = df_analyze['concepts'].apply(len)

        print(f"\n[3/8] Concept extraction complete")
        print(f"  Concepts extracted successfully")
        print(f"  Mean concepts per impression: {df_analyze['n_concepts'].mean():.2f}")
        print(f"  Median concepts per impression: {df_analyze['n_concepts'].median():.2f}")
        print(f"  Std: {df_analyze['n_concepts'].std():.2f}")

        # Calculate concept density
        print(f"\n[4/8] Calculating concept density...")
        df_analyze['concept_density'] = df_analyze.apply(
            lambda row: calculate_concept_density(row['impression_clean'], row['concepts']),
            axis=1
        )

        # Calculate word count
        df_analyze['word_count'] = df_analyze['impression_clean'].astype(str).str.split().str.len()
    
    print(f"  Mean concept density: {df_analyze['concept_density'].mean():.4f} concepts/word")
    print(f"  Median concept density: {df_analyze['concept_density'].median():.4f}")
    print(f"  Std: {df_analyze['concept_density'].std():.4f}")
    
    # Calculate edit distances for the analyzed sample
    print(f"\n[5/8] Calculating edit distances for analyzed sample...")

    # Calculate edit distance for the sample
    df_analyze['edit_distance'] = df_analyze.apply(
        lambda row: compute_edit_distance_with_blank_zero(row['omni_impression'], row['impression_clean']),
        axis=1
    )
    
    # Calculate normalized edit distance
    df_analyze['normalized_edit_distance'] = df_analyze.apply(
        lambda row: compute_normalized_edit_distance_with_blank_zero(row['omni_impression'], row['impression_clean']),
        axis=1
    )
    
    # Load modality-level statistics for context
    df_edit = pd.read_csv(EDIT_DISTANCE_MODALITY_PATH)
    
    # Map the pre-calculated modality statistics to each row
    modality_edit_dict = df_edit.set_index('Modality')[
        ['edit_dist_mean', 'norm_edit_mean', 'word_norm_edit_mean']
    ].to_dict('index')
    
    # Add modality-level metrics to analyzed data
    df_analyze['modality_edit_dist_mean'] = df_analyze['modality_server'].map(
        lambda m: modality_edit_dict.get(m, {}).get('edit_dist_mean', np.nan)
    )
    df_analyze['modality_word_norm_edit_mean'] = df_analyze['modality_server'].map(
        lambda m: modality_edit_dict.get(m, {}).get('word_norm_edit_mean', np.nan)
    )
    
    # Calculate concept complexity relative to modality mean
    df_analyze['concept_density_zscore'] = df_analyze.groupby('modality_server')[
        'concept_density'
    ].transform(lambda x: (x - x.mean()) / x.std() if x.std() > 0 else 0)
    
    print(f"  Edit distances calculated for sample")
    
    # Correlation analysis by modality
    print(f"\n[6/8] Correlation analysis by modality...")
    print(f"  {'Modality':<12} {'n':<8} {'Concept Density':<20} {'Edit Distance Mean':<20} {'Correlation':<15} {'p-value':<12}")
    print(f"  {'-'*100}")
    
    correlation_results = []
    
    for modality in df_analyze['modality_server'].unique():
        if pd.isna(modality):
            continue
        
        df_mod = df_analyze[df_analyze['modality_server'] == modality]
        
        if len(df_mod) < 3:
            continue
        
        # Correlation between concept density and edit distance
        cors, pval = stats.spearmanr(
            df_mod['concept_density'].dropna(),
            df_mod['edit_distance'].dropna()
        )
        
        print(f"  {modality:<12} {len(df_mod):<8} {df_mod['concept_density'].mean():<20.4f} {df_mod['edit_distance'].mean():<20.2f} {cors:<15.4f} {pval:<12.4e}")
        
        correlation_results.append({
            'Modality': modality,
            'n': len(df_mod),
            'concept_density_mean': df_mod['concept_density'].mean(),
            'concept_density_std': df_mod['concept_density'].std(),
            'edit_distance_mean': df_mod['edit_distance'].mean(),
            'edit_distance_std': df_mod['edit_distance'].std(),
            'word_count_mean': df_mod['word_count'].mean(),
            'correlation': cors,
            'p_value': pval,
            'significant': 'Yes' if pval < 0.05 else 'No'
        })
    
    df_correlation = pd.DataFrame(correlation_results)
    
    # Overall correlation
    cors_all, pval_all = stats.spearmanr(
        df_analyze['concept_density'].dropna(),
        df_analyze['edit_distance'].dropna()
    )
    print(f"\n  OVERALL CORRELATION:")
    print(f"  Spearman r = {cors_all:.4f}, p = {pval_all:.4e}")
    
    # Visualizations
    print(f"\n[7/8] Generating visualizations...")

    # ── Figure 1: Per-modality scatter plots (concept density vs edit distance) ──
    modalities_plot = [r['Modality'] for _, r in df_correlation.iterrows()
                       if pd.notna(r['Modality']) and r['n'] >= 5]
    n_mods = len(modalities_plot)
    ncols = min(3, n_mods)
    nrows = int(np.ceil(n_mods / ncols))

    cmap = plt.get_cmap('tab10')
    mod_color = {m: cmap(i % 10) for i, m in enumerate(modalities_plot)}

    fig, axes = plt.subplots(nrows, ncols, figsize=(7 * ncols, 6 * nrows), squeeze=False)
    fig.suptitle('Concept Density vs Edit Distance — Per Modality', fontsize=16, fontweight='bold', y=1.01)

    for idx, modality in enumerate(modalities_plot):
        ax = axes[idx // ncols][idx % ncols]
        mod_data = df_analyze[df_analyze['modality_server'] == modality].dropna(
            subset=['concept_density', 'edit_distance'])
        mod_data = mod_data[np.isfinite(mod_data['concept_density']) & np.isfinite(mod_data['edit_distance'])]

        cor_row = df_correlation[df_correlation['Modality'] == modality].iloc[0]
        r_val   = cor_row['correlation']
        p_val   = cor_row['p_value']
        n_val   = len(mod_data)

        # Scatter
        ax.scatter(mod_data['concept_density'], mod_data['edit_distance'],
                   alpha=0.25, s=15, color=mod_color[modality], edgecolors='none')

        # Regression line
        if n_val >= 3:
            m_fit, b_fit = np.polyfit(mod_data['concept_density'], mod_data['edit_distance'], 1)
            x_line = np.linspace(mod_data['concept_density'].min(), mod_data['concept_density'].max(), 200)
            ax.plot(x_line, m_fit * x_line + b_fit, color='black', linewidth=1.5, linestyle='--')

        sig_str = '***' if p_val < 0.001 else ('**' if p_val < 0.01 else ('*' if p_val < 0.05 else 'ns'))
        ax.set_title(f'{modality}  (n={n_val:,})\nSpearman r={r_val:.3f}, p={p_val:.2e} {sig_str}',
                     fontsize=11, fontweight='bold')
        ax.set_xlabel('Concept Density (concepts/word)', fontsize=10)
        ax.set_ylabel('Edit Distance (characters)', fontsize=10)
