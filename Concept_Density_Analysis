def calculate_concept_density(impression_text, concepts):

    if not impression_text or pd.isna(impression_text):
        return 0.0
    
    word_count = len(str(impression_text).split())
    if word_count == 0:
        return 0.0
    
    return len(concepts) / word_count


def clean_impression_field(val):
    """Normalize blank/NA/NAN impressions to empty string."""
    if pd.isna(val):
        return ''
    s = str(val).strip()
    if s.lower() in ['nan', 'na']:
        return ''
    return s


def compute_edit_distance_with_blank_zero(omni_text, impression_text):
    """Treat blank/NA final impression with populated omni as zero-edit."""
    if pd.isna(omni_text):
        return np.nan
    s1 = str(omni_text).strip()
    s2 = '' if pd.isna(impression_text) else str(impression_text).strip()
    if s2 == '':
        return 0
    if s1 == '':
        return np.nan
    return levenshtein_distance(s1, s2)


def compute_normalized_edit_distance_with_blank_zero(omni_text, impression_text):
    """Character-normalized edit distance with blank final impression treated as zero-edit."""
    dist = compute_edit_distance_with_blank_zero(omni_text, impression_text)
    if pd.isna(dist):
        return np.nan
    s1 = '' if pd.isna(omni_text) else str(omni_text).strip()
    s2 = '' if pd.isna(impression_text) else str(impression_text).strip()
    if s2 == '':
        return 0.0
    max_len = max(len(s1), len(s2))
    return dist / max_len if max_len > 0 else 0.0


def build_or_update_concept_map(unique_impressions):
    """Build concept map with checkpoint resume support."""
    concept_map = {}
    if os.path.exists(_checkpoint_file):
        try:
            with open(_checkpoint_file, 'rb') as f:
                concept_map = pickle.load(f)
            print(f"  Resuming from checkpoint: {len(concept_map):,} impressions already processed")
        except Exception as e:
            print(f"  Warning: Could not load checkpoint ({e}), starting fresh")
            concept_map = {}

    remaining = [x for x in unique_impressions if x not in concept_map]
    print(f"  Remaining to process: {len(remaining):,}")

    for i, text in enumerate(tqdm(remaining, desc='UMLS extraction')):
        concept_map[text] = extract_concept_candidates(text, use_umls_api=True, api_key=UMLS_API_KEY)
        if (i + 1) % CHECKPOINT_INTERVAL == 0:
            try:
                with open(_checkpoint_file, 'wb') as f:
                    pickle.dump(concept_map, f)
                save_umls_cache()
            except Exception as e:
                print(f"  Warning: checkpoint save failed: {e}")

    try:
        with open(_checkpoint_file, 'wb') as f:
            pickle.dump(concept_map, f)
    except Exception as e:
        print(f"  Warning: final checkpoint save failed: {e}")
    save_umls_cache()

    print(f"  ✓ Cache saved with {len(_umls_cache):,} unique phrase queries")
    print(f"  ✓ Checkpoint saved with {len(concept_map):,} processed impressions")
    return concept_map


def main():
    parser = argparse.ArgumentParser(description='UMLS concept density analysis with optional correlation refresh mode.')
